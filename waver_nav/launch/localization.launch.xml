<launch>
    <arg name="use_sim_time" default="true" />
    <arg name="params_file" default="$(find-pkg-share waver_nav)/param/nav2_amcl.yaml" />
    <arg name="map_file" default="$(find-pkg-share waver_nav)/maps/room.yaml" />

    <!-- AMCL node -->
    <node name="waver_amcl" pkg="nav2_amcl" exec="amcl" output="screen">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <!-- Map server node -->
    <node name="waver_map_server" pkg="nav2_map_server" exec="map_server" output="screen">
        <param name="yaml_filename" value="$(var map_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

    <node name="waver_lifecycle_manager_localization" pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
        output="screen">
        <param name="autostart" value="true" />
        <param name="node_names" value="['waver_amcl', 'waver_map_server']" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

</launch>
