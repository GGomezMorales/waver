<launch>
    <arg name="backend" default="slam_toolbox" />
    <arg name="use_sim_time" default="true" />

    <include file="$(find-pkg-share waver_mapping)/launch/online_async.launch.xml"
        if="$(eval '&quot;$(var backend)&quot; == &quot;slam_toolbox&quot;')">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
    </include>

    <include file="$(find-pkg-share waver_mapping)/launch/cartographer.launch.xml"
        if="$(eval '&quot;$(var backend)&quot; == &quot;cartographer&quot;')">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
    </include>
</launch>
