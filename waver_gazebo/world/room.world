<?xml version="1.0"?>
<sdf version="1.5">
    <world name="default">
        <include>
            <uri>model://sun</uri>
        </include>

        <include>
            <uri>model://ground_plane</uri>
        </include>

        <include>
            <uri>model://room</uri>
            <pose>0 0 0 0 0 0</pose>
        </include>

        <gui fullscreen='0'>
            <camera name='user_camera'>
                <pose>2.5 -2.5 2.5 0 0.610865 2.35619</pose>
                <view_controller>orbit</view_controller>
                <projection_type>perspective</projection_type>
            </camera>
        </gui>
    </world>
</sdf>